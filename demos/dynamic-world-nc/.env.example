# ── Earth Engine (mode réel) ────────────────────────────────────────────────
# Authentification via Application Default Credentials (ADC) :
# résolue automatiquement par google-auth-library (gcloud, variables d'env,
# métadonnées GCP…) — aucun fichier de clé ici.
# EE_PROJECT=mon-projet-gee

# ── Mode de fonctionnement ──────────────────────────────────────────────────
# "mock" (défaut) : tuiles synthétiques locales, aucune clé requise.
# "gee"          : tuiles réelles Dynamic World via ADC.
# EE_MODE=gee

# ── Réseau ──────────────────────────────────────────────────────────────────
# PORT=8080

# ── Zone d'intérêt (côte ouest — bassins PPE) ───────────────────────────────
# Longitude min, latitude min, longitude max, longitude max
# AOI=163.4,-21.9,165.6,-20.4